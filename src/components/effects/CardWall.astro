---
import type { CardItem } from "../../data/cards";

interface Props {
	items: CardItem[];
	tabs?: string[]; // 传入则渲染分类筛选标签；第一项视为「全部」
	heading?: string;
	subtitle?: string;
}

const { items, tabs, heading, subtitle } = Astro.props;
---
<div class="cw-wrap">
    {heading && <div class="cw-head">
        <h2 class="cw-title">{heading}</h2>
        {subtitle && <p class="cw-sub">{subtitle}</p>}
    </div>}

    {tabs && tabs.length > 0 && (
        <div class="cw-tabs" role="tablist">
            {tabs.map((t, i) => (
                <button class:list={["cw-tab", { on: i === 0 }]} data-cat={i === 0 ? "all" : t}>{t}</button>
            ))}
        </div>
    )}

    <div class="cw-grid">
        {items.map((c) => {
            const Tag = c.url ? "a" : "div";
            return (
                <Tag
                    class:list={["cw-card", { "has-img": !!c.image }]}
                    data-cat={c.category ?? "all"}
                    {...(c.url ? { href: c.url, target: "_blank", rel: "noopener" } : {})}
                >
                    {c.image && (
                        <div class:list={["cw-media", { contain: c.imageFit === "contain" }]} style={c.imageBg ? `background: ${c.imageBg}` : undefined}>
                            <img src={c.image} alt={c.title} loading="lazy" class="cw-img" />
                        </div>
                    )}
                    <div class="cw-ct">
                        <b>{c.title}</b>
                        {c.url && (
                            <svg class="cw-ext" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M7 17 17 7M9 7h8v8"/>
                            </svg>
                        )}
                    </div>
                    {c.desc && <p class="cw-desc">{c.desc}</p>}
                    <div class="cw-foot">
                        <div class="cw-tags">
                            {c.tags.map((t) => <span class="cw-tag">{t}</span>)}
                        </div>
                        {c.badge && <span class:list={["cw-badge", c.badgeColor ? `cw-badge-${c.badgeColor}` : ""]}>{c.badge}</span>}
                    </div>
                </Tag>
            );
        })}
    </div>
</div>

<style>
    .cw-wrap {
        background: linear-gradient(135deg, #e6f7f3 0%, #e3f4fb 55%, #eef9f6 100%);
        border-radius: 18px;
        padding: 22px 20px 26px;
        position: relative;
    }
    .cw-head { margin-bottom: 16px; }
    .cw-title {
        font-size: 22px; font-weight: 600; margin: 0;
        background: linear-gradient(90deg, #1fc9e7, #35bfab);
        -webkit-background-clip: text; background-clip: text; color: transparent;
        width: fit-content;
    }
    .cw-sub { font-size: 13px; color: #7b888e; margin: 4px 0 0; }
    .cw-tabs { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 18px; }
    .cw-tab {
        font-size: 13px; padding: 6px 14px; border-radius: 999px; cursor: pointer;
        border: 1px solid rgba(53,191,171,.35); background: rgba(255,255,255,.45);
        color: #334f52; transition: all .2s;
    }
    .cw-tab:hover { border-color: rgba(53,191,171,.7); }
    .cw-tab.on {
        background: linear-gradient(90deg, #1fc9e7, #35bfab); color: #fff;
        border-color: transparent; box-shadow: 0 4px 12px rgba(53,191,171,.35);
    }
    .cw-grid {
        display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 14px;
    }
    .cw-card {
        background: rgba(255,255,255,.5);
        -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px);
        border: 1px solid rgba(255,255,255,.7); border-radius: 14px;
        padding: 12px 12px 13px; box-shadow: 0 6px 20px rgba(51,79,82,.08);
        transition: transform .22s, box-shadow .22s;
        display: flex; flex-direction: column; gap: 9px; text-decoration: none; color: inherit;
    }
    a.cw-card:hover { transform: translateY(-4px); box-shadow: 0 12px 28px rgba(53,191,171,.22); }
    @media (prefers-reduced-motion: no-preference) {
        @keyframes cw-fade-up { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: translateY(0); } }
        .cw-card { animation: cw-fade-up .5s cubic-bezier(.22,.61,.36,1) backwards; }
        .cw-card:nth-child(2) { animation-delay: .06s; }
        .cw-card:nth-child(3) { animation-delay: .12s; }
        .cw-card:nth-child(4) { animation-delay: .18s; }
        .cw-card:nth-child(5) { animation-delay: .24s; }
        .cw-card:nth-child(6) { animation-delay: .3s; }
        .cw-card:nth-child(n+7) { animation-delay: .36s; }
    }
    .cw-media {
        overflow: hidden; border-radius: 12px;
        aspect-ratio: 16 / 9;
        background: linear-gradient(135deg, rgba(31,201,231,.18), rgba(53,191,171,.18));
        border: 1px solid rgba(255,255,255,.66);
        display: flex; align-items: center; justify-content: center;
    }
    .cw-img { width: 100%; height: 100%; display: block; object-fit: cover; }
    .cw-media.contain { padding: 12px; }
    .cw-media.contain .cw-img { object-fit: contain; }
    .cw-ct { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
    .cw-ct b { font-size: 15px; font-weight: 600; color: #2b4548; }
    .cw-ext { color: #35bfab; flex-shrink: 0; }
    .cw-desc { font-size: 12.5px; line-height: 1.6; color: #7b888e; margin: 0; min-height: 34px; }
    .cw-foot { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-top: 2px; }
    .cw-tags { display: flex; flex-wrap: wrap; gap: 5px; }
    .cw-tag { font-size: 11px; padding: 2px 8px; border-radius: 999px; background: rgba(31,201,231,.14); color: #147a8c; }
    .cw-badge { font-size: 11px; white-space: nowrap; font-weight: 500; padding: 2px 9px; border-radius: 999px; background: rgba(53,191,171,.14); color: #147a8c; }
    .cw-badge-green { background: rgba(29,158,117,.15); color: #0f6e56; }
    .cw-badge-amber { background: rgba(186,117,23,.16); color: #854f0b; }
    .cw-badge-blue { background: rgba(55,138,221,.15); color: #185fa5; }
    :global(html.dark) .cw-badge { background: rgba(53,191,171,.18); color: #6fd9ec; }
    :global(html.dark) .cw-badge-green { background: rgba(29,158,117,.22); color: #5dcaa5; }
    :global(html.dark) .cw-badge-amber { background: rgba(234,179,8,.18); color: #fac775; }
    :global(html.dark) .cw-badge-blue { background: rgba(55,138,221,.22); color: #85b7eb; }

    :global(html.dark) .cw-wrap { background: linear-gradient(135deg, #0f2a2b 0%, #0c2230 55%, #102b2a 100%); }
    :global(html.dark) .cw-tab { background: rgba(255,255,255,.06); color: #cfe7e4; border-color: rgba(53,191,171,.3); }
    :global(html.dark) .cw-card { background: rgba(255,255,255,.06); border-color: rgba(255,255,255,.1); box-shadow: 0 6px 20px rgba(0,0,0,.25); }
    :global(html.dark) .cw-media { border-color: rgba(255,255,255,.1); background: linear-gradient(135deg, rgba(31,201,231,.12), rgba(53,191,171,.12)); }
    :global(html.dark) .cw-ct b { color: #e3f3f1; }
    :global(html.dark) .cw-desc { color: #8aa3a3; }
    :global(html.dark) .cw-tag { background: rgba(31,201,231,.16); color: #6fd9ec; }
</style>

<script is:inline>
    (function () {
        function bind() {
            document.querySelectorAll(".cw-tabs").forEach(function (tabs) {
                if (tabs.dataset.bound) return;
                tabs.dataset.bound = "1";
                var grid = tabs.parentElement.querySelector(".cw-grid");
                tabs.addEventListener("click", function (e) {
                    var t = e.target.closest(".cw-tab");
                    if (!t) return;
                    tabs.querySelectorAll(".cw-tab").forEach(function (x) { x.classList.remove("on"); });
                    t.classList.add("on");
                    var c = t.dataset.cat;
                    grid.querySelectorAll(".cw-card").forEach(function (card) {
                        card.style.display = (c === "all" || card.dataset.cat === c) ? "" : "none";
                    });
                });
            });
        }
        bind();
        var h = setInterval(function () {
            if (window.swup && window.swup.hooks) { clearInterval(h); window.swup.hooks.on("page:view", bind); }
        }, 500);
    })();
</script>
