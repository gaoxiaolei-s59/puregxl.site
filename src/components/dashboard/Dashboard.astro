---
import { profileConfig } from "../../config";
import { getSortedPosts } from "../../utils/content-utils";
import { formatDateToYYYYMMDD } from "../../utils/date-utils";
import { getPostUrlBySlug } from "../../utils/url-utils";
import ImageWrapper from "../misc/ImageWrapper.astro";

const posts = await getSortedPosts();
const latest = posts[0] ?? null;
const pool = posts.slice(1);
const random = pool.length ? pool[Math.floor(Math.random() * pool.length)] : latest;

const githubLink = profileConfig.links.find((l) => l.name === "GitHub")?.url;
const email = "chaungoc0912@gmail.com";

const menu = [
	{ name: "文章", url: "/blog/", icon: "material-symbols:article-outline-rounded" },
	{ name: "项目", url: "/projects/", icon: "material-symbols:apps-rounded" },
	{ name: "热爱的游戏", url: "/games/", icon: "material-symbols:sports-esports-outline" },
	{ name: "分享", url: "/share/", icon: "material-symbols:star-outline-rounded" },
	{ name: "关于", url: "/about/", icon: "material-symbols:sentiment-satisfied-outline" },
];

const langs = [
	{ name: "Java", icon: "/tech/java.svg" },
	{ name: "Python", icon: "/tech/python.svg" },
	{ name: "Go", icon: "/tech/go.svg" },
	{ name: "React", icon: "/tech/react.svg" },
];
---
<div class="dash-bg" aria-hidden="true">
    <img class="dash-media" src="/home-banner-poster.jpg" alt="" />
    <video id="dash-video" class="dash-media" muted loop playsinline preload="none"
           poster="/home-banner-poster.jpg" data-video-src="/home-banner-video.mp4"></video>
    <div class="dash-overlay"></div>
</div>

<div class="dash">
    <div class="dash-grid">
        <!-- 资料 + 菜单 -->
        <section class="d-card d-prof">
            <div class="d-prof-top">
                <ImageWrapper src={profileConfig.avatar} alt={profileConfig.name} class="d-ava" />
                <b>{profileConfig.name}</b>
            </div>
            <p class="d-label">GENERAL</p>
            <nav class="d-menu">
                {menu.map((m) => (
                    <a href={m.url} class="d-mi"><span class="d-mi-dot"></span>{m.name}</a>
                ))}
            </nav>
            <p class="d-label" style="margin-top:14px;">语言</p>
            <div class="d-langs">
                {langs.map((l) => (
                    <span class="d-lang"><img src={l.icon} alt={l.name} loading="lazy" />{l.name}</span>
                ))}
            </div>
        </section>

        <!-- 问候 + 社交 -->
        <section class="d-card d-greet">
            <ImageWrapper src={profileConfig.avatar} alt={profileConfig.name} class="d-gava" />
            <p class="d-hi" id="dash-greet">Hello</p>
            <p class="d-hi2">I'm <b>{profileConfig.name}</b>, nice to meet you!</p>
            <div class="d-social">
                {githubLink && <a href={githubLink} target="_blank" rel="noopener" class="d-soc">GitHub</a>}
                <a href={`mailto:${email}`} class="d-soc alt">邮箱</a>
            </div>
        </section>

        <!-- 时钟 -->
        <section class="d-card d-clock"><div id="dash-clock">--:--</div></section>

        <!-- 日历 -->
        <section class="d-card d-cal">
            <div class="d-cal-top" id="dash-cal-top"></div>
            <div class="d-cal-grid" id="dash-cal"></div>
        </section>

        <!-- 最新文章 -->
        {latest && (
            <a class="d-card d-post d-latest" href={getPostUrlBySlug(latest.slug)}>
                <p class="d-plabel">最新文章</p>
                <p class="d-pt">{latest.data.title}</p>
                <p class="d-pd">{formatDateToYYYYMMDD(latest.data.published)}</p>
            </a>
        )}

        <!-- 随机推荐 -->
        {random && (
            <a class="d-card d-post d-random" href={getPostUrlBySlug(random.slug)}>
                <p class="d-plabel">随机推荐</p>
                <p class="d-pt">{random.data.title}</p>
                <p class="d-pd">{random.data.tags?.slice(0, 2).join(" · ") || formatDateToYYYYMMDD(random.data.published)}</p>
            </a>
        )}
    </div>
</div>

<style>
    .dash-bg { position: fixed; inset: 0; z-index: 0; overflow: hidden; }
    .dash-media { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: blur(3px) brightness(1.02) saturate(1.08); transform: scale(1.06); }
    #dash-video { opacity: 0; transition: opacity .6s; }
    #dash-video.ready { opacity: 1; }
    .dash-overlay { position: absolute; inset: 0; background: rgba(255, 255, 255, .22); }
    :global(html.dark) .dash-overlay { background: rgba(8, 18, 22, .42); }

    .dash { position: relative; z-index: 10; max-width: 1080px; margin: 0 auto; padding: clamp(1rem, 4vh, 3rem) 1rem 3rem; min-height: calc(100vh - 5.5rem); display: flex; align-items: center; }
    .dash-grid {
        width: 100%;
        display: grid;
        grid-template-columns: 1fr 1.4fr 1fr;
        grid-template-areas:
            "prof greet clock"
            "prof greet cal"
            "latest random cal";
        gap: 14px;
    }
    .d-card {
        background: rgba(255,255,255,.5);
        -webkit-backdrop-filter: blur(16px); backdrop-filter: blur(16px);
        border: 1px solid rgba(255,255,255,.65); border-radius: 16px;
        box-shadow: 0 8px 28px rgba(51,79,82,.12); padding: 16px 18px; color: #2f4f49;
        text-decoration: none;
    }
    :global(html.dark) .d-card { background: rgba(255,255,255,.07); border-color: rgba(255,255,255,.12); color: #dceeeb; box-shadow: 0 8px 28px rgba(0,0,0,.3); }

    .d-prof { grid-area: prof; }
    .d-prof-top { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; }
    .d-prof-top b { font-size: 16px; font-weight: 600; }
    :global(.d-ava) { width: 38px !important; height: 38px; border-radius: 50%; flex-shrink: 0; }
    .d-label { font-size: 10px; letter-spacing: 1.5px; color: #7b888e; margin: 0 0 8px; }
    .d-menu { display: flex; flex-direction: column; gap: 2px; }
    .d-mi { display: flex; align-items: center; gap: 10px; font-size: 14px; padding: 9px 10px; border-radius: 10px; color: inherit; text-decoration: none; transition: background .2s; }
    .d-mi:hover { background: rgba(53,191,171,.16); }
    .d-mi-dot { width: 7px; height: 7px; border-radius: 50%; background: #35bfab; flex-shrink: 0; }
    .d-langs { display: flex; flex-wrap: wrap; gap: 7px; }
    .d-lang { display: inline-flex; align-items: center; gap: 5px; font-size: 12px; padding: 4px 9px; border-radius: 999px; background: rgba(255,255,255,.55); border: 1px solid rgba(53,191,171,.25); color: #2f4f49; }
    .d-lang img { width: 15px; height: 15px; display: block; }
    :global(html.dark) .d-lang { background: rgba(255,255,255,.08); border-color: rgba(255,255,255,.12); color: #dceeeb; }

    .d-greet { grid-area: greet; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; gap: 6px; }
    :global(.d-gava) { width: 84px !important; height: 84px; border-radius: 50%; margin-bottom: 8px; box-shadow: 0 0 0 6px rgba(255,255,255,.35); flex-shrink: 0; }
    .d-hi { font-size: 26px; font-weight: 700; margin: 0; }
    .d-hi2 { font-size: 16px; margin: 0; color: #52736d; }
    :global(html.dark) .d-hi2 { color: #9fbab5; }
    .d-hi2 b { color: #1fa9c4; font-style: italic; }
    .d-social { display: flex; gap: 10px; margin-top: 14px; flex-wrap: wrap; justify-content: center; }
    .d-soc { font-size: 13px; padding: 8px 16px; border-radius: 11px; background: rgba(47,79,73,.92); color: #fff; text-decoration: none; transition: transform .2s; }
    .d-soc.alt { background: rgba(255,255,255,.72); color: #2f4f49; }
    :global(html.dark) .d-soc.alt { background: rgba(255,255,255,.16); color: #dceeeb; }
    .d-soc:hover { transform: translateY(-2px); }

    .d-clock { grid-area: clock; display: flex; align-items: center; justify-content: center; }
    .d-clock #dash-clock, .d-clock > div { font-family: ui-monospace, "SFMono-Regular", monospace; font-size: clamp(28px, 4vw, 40px); font-weight: 700; letter-spacing: 3px; }

    .d-cal { grid-area: cal; }
    .d-cal-top { font-size: 13px; color: #52736d; margin-bottom: 10px; }
    :global(html.dark) .d-cal-top { color: #9fbab5; }
    .d-cal-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 4px; font-size: 12px; text-align: center; }
    .d-cal-grid span { padding: 5px 0; border-radius: 7px; }
    .d-cal-grid .wd { color: #9aa8a4; font-size: 11px; }
    .d-cal-grid .tdy { background: #35bfab; color: #fff; font-weight: 700; }

    .d-latest { grid-area: latest; }
    .d-random { grid-area: random; }
    .d-post { transition: transform .2s, box-shadow .2s; }
    .d-post:hover { transform: translateY(-3px); box-shadow: 0 12px 30px rgba(53,191,171,.24); }
    .d-plabel { font-size: 11px; color: #7b888e; margin: 0 0 6px; }
    .d-pt { font-size: 15px; font-weight: 600; margin: 0; }
    .d-pd { font-size: 12px; color: #7b888e; margin: 6px 0 0; }

    @media (max-width: 768px) {
        .dash { padding-top: 1.5rem; min-height: 0; }
        .dash-grid { grid-template-columns: 1fr; grid-template-areas: "greet" "prof" "clock" "cal" "latest" "random"; }
    }
</style>

<script is:inline>
    (function () {
        function setup() {
            var v = document.getElementById("dash-video");
            if (v && !v.dataset.bound) {
                v.dataset.bound = "1";
                var fine = window.matchMedia("(pointer: fine)").matches;
                var reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
                if (fine && !reduced && v.dataset.videoSrc) {
                    v.src = v.dataset.videoSrc;
                    v.addEventListener("playing", function () { v.classList.add("ready"); });
                    v.play().catch(function () {});
                }
            }
            var greet = document.getElementById("dash-greet");
            if (greet) {
                var h = new Date().getHours();
                greet.textContent = h < 5 ? "Good night" : h < 11 ? "Good morning" : h < 14 ? "Good noon" : h < 18 ? "Good afternoon" : "Good evening";
            }
            var clk = document.getElementById("dash-clock");
            if (clk && !clk.dataset.bound) {
                clk.dataset.bound = "1";
                var pad = function (n) { return n < 10 ? "0" + n : "" + n; };
                var tick = function () { var d = new Date(); clk.textContent = pad(d.getHours()) + ":" + pad(d.getMinutes()); };
                tick(); setInterval(tick, 1000);
            }
            var cal = document.getElementById("dash-cal");
            var top = document.getElementById("dash-cal-top");
            if (cal && top) {
                var wd = ["一", "二", "三", "四", "五", "六", "日"];
                var now = new Date(), y = now.getFullYear(), m = now.getMonth(), today = now.getDate();
                top.textContent = y + "/" + (m + 1) + "/" + today + " 周" + wd[(now.getDay() + 6) % 7];
                var html = "";
                wd.forEach(function (w) { html += '<span class="wd">' + w + "</span>"; });
                var off = (new Date(y, m, 1).getDay() + 6) % 7;
                for (var i = 0; i < off; i++) html += "<span></span>";
                var days = new Date(y, m + 1, 0).getDate();
                for (var d = 1; d <= days; d++) html += '<span class="' + (d === today ? "tdy" : "") + '">' + d + "</span>";
                cal.innerHTML = html;
            }
        }
        setup();
        if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", setup);
        var hk = setInterval(function () {
            if (window.swup && window.swup.hooks) { clearInterval(hk); window.swup.hooks.on("page:view", setup); }
        }, 500);
    })();
</script>
