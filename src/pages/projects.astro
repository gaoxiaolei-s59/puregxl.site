---
import CardWall from "@components/effects/CardWall.astro";
import { openSource, projects } from "../data/cards";
import MainGridLayout from "../layouts/MainGridLayout.astro";
---
<MainGridLayout title="项目" description="我的项目与开源贡献">
    <div class="flex flex-col gap-6">
        <CardWall items={projects} heading="项目" subtitle="做过和正在做的东西" />
        <CardWall items={openSource} heading="开源贡献" subtitle="保持开源贡献习惯 · 参与 Issue 讨论与 PR 提交 · 熟悉社区协作流程" />
    </div>
</MainGridLayout>
